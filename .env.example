# Small-model backend for ALL non-Gemini LLM calls: "ollama" (local, reproducible) or "hf"
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=16384

# Only used when LLM_BACKEND=hf
HF_API_TOKEN=your-hugging-face-api-token-here
LOCAL_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

ENABLE_RLM_REASONING=true
ENABLE_EGV=true